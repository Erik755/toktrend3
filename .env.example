# AI provider. Do not commit real keys to GitHub.
# Groq:
GROQ_API_KEY=your_groq_api_key_here
AI_BASE_URL=https://api.groq.com/openai/v1
AGENT_MODEL=llama-3.3-70b-versatile

# Together alternative:
# TOGETHER_API_KEY=your_together_api_key_here
# AI_BASE_URL=https://api.together.xyz/v1
# AGENT_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo

# OpenAI alternative:
# OPENAI_API_KEY=your_openai_api_key_here
# AGENT_MODEL=gpt-4.1-mini

# Professional narration. Uses OPENAI_API_KEY unless TTS_API_KEY is set.
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=onyx
TTS_SPEED=0.96
PORT=8787
CORS_ORIGIN=*
TIKTOK_CLIENT_KEY=your_tiktok_client_key_here
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret_here
TIKTOK_REDIRECT_URI=https://toktrend3.onrender.com/api/tiktok/oauth/callback

# Abacus AI multimedia endpoints (opcionales)
ABACUS_API_KEY=your_abacus_api_key_here
ABACUS_IMAGE_API_URL=abacus_image_endpoint
ABACUS_VIDEO_API_URL=abacus_video_endpoint
ABACUS_AUDIO_API_URL=abacus_audio_endpoint

# API opcional para tendencias de TikTok
TIKTOK_TRENDS_API_URL=
TIKTOK_TRENDS_API_KEY=
